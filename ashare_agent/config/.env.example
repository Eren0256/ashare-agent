DEEPSEEK_API_KEY=
DEEPSEEK_API_BASE=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

LLM_TIMEOUT=60
LLM_MAX_RETRIES=2

CACHE_REDIS_URL=redis://127.0.0.1:6379/1
CACHE_KEY_PREFIX=ashare-agent:cache
CACHE_LOCK_TTL_SECONDS=300
CACHE_LOCK_WAIT_TIMEOUT_SECONDS=300

DATABASE_URL=postgresql+asyncpg://ashare_agent:ashare_agent@127.0.0.1:5432/ashare_agent
DATABASE_AUTO_CREATE_SCHEMA=false

REDIS_URL=redis://127.0.0.1:6379/0
REDIS_JOB_STREAM=ashare-agent:jobs
REDIS_JOB_CONSUMER_GROUP=ashare-agent-workers
REDIS_JOB_BLOCK_MS=1000
REDIS_JOB_CLAIM_IDLE_MS=300000
JOB_OUTBOX_DISPATCH_INTERVAL_SECONDS=1
